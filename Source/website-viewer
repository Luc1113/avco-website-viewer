def github_request(url, token=None, method="GET", data=None, form=False, accept="application/vnd.github+json"):
    headers = {"Accept": accept, "User-Agent": "AVCO-Website-Viewer"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    body = None
    if data is not None:
        if form:
            body = urllib.parse.urlencode(data).encode()
            headers["Content-Type"] = "application/x-www-form-urlencoded"
        else:
            body = json.dumps(data).encode()
            headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            raw = response.read().decode()
            return True, (json.loads(raw) if raw else {}), dict(response.headers)
    except urllib.error.HTTPError as exc:
        try:
            detail = json.loads(exc.read().decode())
        except (ValueError, OSError):
            detail = {"message": str(exc)}
        return False, detail, dict(exc.headers or {})
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        return False, {"message": str(exc)}, {}


def github_start_device_flow():
    ok, data, _ = github_request(
        "https://github.com/login/device/code",
        method="POST",
        data={"client_id": GITHUB_CLIENT_ID, "scope": "read:org repo"},
        form=True,
        accept="application/json",
    )
    if not ok or "device_code" not in data:
        return False, data.get("error_description") or data.get("message") or "Could not start GitHub sign-in.", None
    subprocess.Popen(["open", data["verification_uri"]])
    return True, "Opened GitHub in your browser.", data


def github_poll_device_flow(device_code):
    ok, data, _ = github_request(
        "https://github.com/login/oauth/access_token",
        method="POST",
        data={
            "client_id": GITHUB_CLIENT_ID,
            "device_code": device_code,
            "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
        },
        form=True,
        accept="application/json",
    )
    error = data.get("error")
    if error in ("authorization_pending", "slow_down"):
        return {"pending": True}
    if error:
        return {"pending": False, "error": data.get("error_description") or error}
    token = data.get("access_token")
    if not token:
        return {"pending": False, "error": "GitHub did not return an access token."}
    ok, user, _ = github_request(f"{GITHUB_API}/user", token=token)
    if not ok:
        return {"pending": False, "error": "Signed in, but could not read your GitHub profile."}
    with GITHUB_LOCK:
        GITHUB_STATE["token"] = token
        GITHUB_STATE["login"] = user.get("login")
        GITHUB_STATE["org"] = None
        save_github_state()
        GITHUB_ORGS_CACHE.update({"time": 0, "orgs": []})
    return {"pending": False, "login": user.get("login")}


def github_orgs(force=False):
    token = GITHUB_STATE.get("token")
    if not token:
        return []
    if not force and time.time() - GITHUB_ORGS_CACHE["time"] < 300:
        return GITHUB_ORGS_CACHE["orgs"]
    ok, data, _ = github_request(f"{GITHUB_API}/user/orgs?per_page=100", token=token)
    orgs = [item["login"] for item in data] if ok and isinstance(data, list) else []
    GITHUB_ORGS_CACHE.update({"time": time.time(), "orgs": orgs})
    return orgs


def github_repos(org, token):
    ok, data, _ = github_request(f"{GITHUB_API}/orgs/{org}/repos?per_page=100&sort=pushed", token=token)
    if not ok or not isinstance(data, list):
        return False, data.get("message", "Could not load repositories."), []
    repos = [
        {
            "name": item["name"],
            "full_name": item["full_name"],
            "default_branch": item.get("default_branch", "main"),
            "private": item.get("private", False),
            "pushed_at": item.get("pushed_at"),
            "html_url": item.get("html_url"),
        }
        for item in data
    ]
    return True, "", repos


def github_branches(owner, repo, token):
    key = f"{owner}/{repo}"
    cached = GITHUB_BRANCH_CACHE.get(key)
    if cached and time.time() - cached["time"] < 60:
        return True, "", cached["branches"]
    ok, data, _ = github_request(f"{GITHUB_API}/repos/{owner}/{repo}/branches?per_page=100", token=token)
    if not ok or not isinstance(data, list):
        return False, data.get("message", "Could not load branches."), []
    branches = [
        {"name": item["name"], "sha": item.get("commit", {}).get("sha", "")[:7]}
        for item in data
    ]
    GITHUB_BRANCH_CACHE[key] = {"time": time.time(), "branches": branches}
    return True, "", branches


def local_git_repos():
    entries = []
    try:
        candidates = sorted(
            (item for item in ROOT.iterdir() if item.is_dir() and (item / ".git").exists()),
            key=lambda item: item.name.lower(),
        )
    except OSError:
        candidates = []
    for folder in candidates:
        branch = git_command(folder, ["branch", "--show-current"]).stdout.strip()
        status = git_command(folder, ["status", "--porcelain"])
        dirty = len([line for line in status.stdout.splitlines() if line.strip()])
        upstream_result = git_command(folder, ["rev-parse", "--verify", "@{u}"])
        upstream = upstream_result.stdout.strip() if upstream_result.returncode == 0 else ""
        ahead = behind = 0
        remote_url = git_command(folder, ["remote", "get-url", "origin"]).stdout.strip()
        if upstream:
            counts = git_command(folder, ["rev-list", "--left-right", "--count", f"HEAD...{upstream}"])
            if counts.returncode == 0 and counts.stdout.strip():
                parts = counts.stdout.strip().split()
                if len(parts) == 2:
                    ahead, behind = int(parts[0]), int(parts[1])
        entries.append({
            "key": str(folder),
            "name": folder.name,
            "branch": branch or "(detached)",
            "dirty": dirty,
            "ahead": ahead,
            "behind": behind,
            "remote": remote_url,
        })
    return entries


def github_clone_or_checkout(owner, repo, branch, token):
    dest = ROOT / repo
    remote_url = f"https://x-access-token:{token}@github.com/{owner}/{repo}.git"
    environment = os.environ.copy()
    environment["GIT_TERMINAL_PROMPT"] = "0"
    if dest.exists():
        if not (dest / ".git").exists():
            return False, f"{dest} already exists and is not a Git repository."
        fetched = subprocess.run(
            ["git", "fetch", remote_url, branch],
            cwd=dest, capture_output=True, text=True, timeout=180, env=environment,
        )
        if fetched.returncode != 0:
            return False, (fetched.stderr.strip().splitlines() or ["Fetch failed."])[-1]
        checkout = subprocess.run(
            ["git", "checkout", "-B", branch, "FETCH_HEAD"],
            cwd=dest, capture_output=True, text=True, timeout=60, env=environment,
        )
        if checkout.returncode != 0:
            return False, (checkout.stderr.strip().splitlines() or ["Checkout failed."])[-1]
        subprocess.run(["git", "branch", f"--set-upstream-to=origin/{branch}", branch], cwd=dest, capture_output=True, text=True, env=environment)
        subprocess.run(["git", "remote", "set-url", "origin", f"https://github.com/{owner}/{repo}.git"], cwd=dest, capture_output=True, text=True, env=environment)
        return True, f"{repo} is now on branch {branch}."
    clone = subprocess.run(
        ["git", "clone", "--branch", branch, remote_url, str(dest)],
        capture_output=True, text=True, timeout=300, env=environment,
    )
    if clone.returncode != 0:
        return False, (clone.stderr.strip().splitlines() or ["Clone failed."])[-1]
    subprocess.run(["git", "remote", "set-url", "origin", f"https://github.com/{owner}/{repo}.git"], cwd=dest, capture_output=True, text=True, env=environment)
    return True, f"Cloned {repo} ({branch}) into {dest}."


def load_settings():
    global ROOT, REFRESH_MS
    try:
        saved = json.loads(SETTINGS_PATH.read_text())
    except (OSError, ValueError):
        return
    root_value = saved.get("root")
    if root_value:
        candidate = Path(root_value).expanduser()
        if candidate.is_dir():
            ROOT = candidate.resolve()
    refresh_value = saved.get("refresh_ms")
    if isinstance(refresh_value, int) and 2000 <= refresh_value <= 120000:
        REFRESH_MS = refresh_value


def save_settings():
    try:
        SETTINGS_PATH.write_text(json.dumps({"root": str(ROOT), "refresh_ms": REFRESH_MS}))
    except OSError:
        pass


def latest_change(folder: Path):
    latest = folder.stat().st_mtime
    checked = 0
    excluded = {".git", "node_modules", ".next", "dist", "build", ".cache"}
    try:
        for current, directories, files in os.walk(folder):
            directories[:] = [name for name in directories if name not in excluded and not name.startswith(".")]
            for name in files:
                try:
                    latest = max(latest, (Path(current) / name).stat().st_mtime)
                except OSError:
                    pass
                checked += 1
                if checked >= 2000:
                    return latest
    except OSError:
        pass
    return latest


def project_command(folder: Path, port: int | None = None):
    package = folder / "package.json"
    if package.is_file():
        try:
            package_data = json.loads(package.read_text())
            scripts = package_data.get("scripts", {})
        except (OSError, json.JSONDecodeError):
            package_data = {}
            scripts = {}

        manager = "npm"
        if (folder / "pnpm-lock.yaml").exists() and shutil.which("pnpm"):
            manager = "pnpm"
        elif (folder / "yarn.lock").exists() and shutil.which("yarn"):
            manager = "yarn"
        elif (folder / "bun.lockb").exists() and shutil.which("bun"):
            manager = "bun"

        for script in ("dev", "start", "serve", "preview"):
            if script in scripts:
                cmd = [manager, "run", script]
                if port:
                    script_text = str(scripts[script]).lower()
                    dependencies = {
                        **package_data.get("dependencies", {}),
                        **package_data.get("devDependencies", {}),
                    }
                    if "next" in dependencies or "next " in script_text:
                        cmd += ["--", "-H", "127.0.0.1", "-p", str(port)]
                    elif any(name in dependencies for name in ("vite", "astro", "nuxt")):
                        cmd += ["--", "--host", "127.0.0.1", "--port", str(port)]
                    # Other frameworks receive PORT and HOST through their
                    # environment instead of potentially incompatible flags.
                return cmd, f"{manager} · {script}"

    if (folder / "index.html").is_file():
        cmd = [sys.executable, "-m", "http.server"]
        if port:
            cmd += [str(port), "--bind", "127.0.0.1"]
        return cmd, "Static HTML"

    return None


def discover():
    candidates = [ROOT]
    try:
        candidates += sorted(
            (item for item in ROOT.iterdir() if item.is_dir() and not item.name.startswith(".")),
            key=lambda item: item.name.lower(),
        )
    except OSError:
        pass

    projects = []
    for folder in candidates:
        details = project_command(folder)
        if not details:
            continue
        _, kind = details
        key = str(folder)
        running = RUNNING.get(key)
        if running and running["process"].poll() is not None:
            RUNNING.pop(key, None)
            running = None
        projects.append(
            {
                "key": key,
                "name": folder.name if folder != ROOT else f"{folder.name} (current folder)",
                "path": str(folder),
                "kind": kind,
                "git": (folder / ".git").exists(),
                "npm": (folder / "package.json").is_file(),
                "modified": latest_change(folder),
                "error": FAILURES.get(key, {}).get("message", ""),
                "building": BUILDS.get(key, {}).get("status") == "running",
                "running": bool(running),
                "url": running["url"] if running else "",
            }
        )
    return sorted(projects, key=lambda project: (project["npm"], project["name"].lower()))


def free_port():
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]


def valid_project(raw_path: str):
    folder = Path(raw_path).resolve()
    if folder != ROOT and folder.parent != ROOT:
        return None
    return folder if project_command(folder) else None


def valid_git_folder(raw_path: str):
    """Like valid_project, but for the GitHub Local/Pushed tabs: any Git
    checkout directly under ROOT counts, even without a runnable dev command."""
    folder = Path(raw_path).resolve()
    if folder.parent != ROOT:
        return None
    return folder if (folder / ".git").exists() else None


def start_project(folder: Path, port_attempt: int = 0):
    key = str(folder)

    def fail(message, log_path, log=None):
        if log and not log.closed:
            log.close()
        FAILURES[key] = {"message": message, "log_path": str(log_path), "time": time.time()}
        return None, message

    with LOCK:
        existing = RUNNING.get(key)
        if existing and existing["process"].poll() is None:
            return existing["url"], None

        port = free_port()
        command, _ = project_command(folder, port)
        log_path = Path("/tmp") / f"website-viewer-{abs(hash(key))}-{port_attempt}.log"
        log = log_path.open("a")
        BUILDS.setdefault(key, {}).update({"log_path": str(log_path)})
        log.write(f"\n--- Started {time.strftime('%Y-%m-%d %H:%M:%S')} ---\n")
        log.flush()

        package = folder / "package.json"
        if package.is_file() and not (folder / "node_modules").exists():
            manager = command[0]
            log.write("Installing missing website dependencies...\n")
            log.flush()
            try:
                setup = subprocess.run(
                    [manager, "install"],
                    cwd=folder,
                    stdout=log,
                    stderr=subprocess.STDOUT,
                    timeout=300,
                )
            except (OSError, subprocess.TimeoutExpired) as exc:
                log.write(f"Setup error: {exc}\n")
                return fail("Website setup failed.", log_path, log)
            if setup.returncode != 0:
                return fail("Website setup failed.", log_path, log)

        environment = os.environ.copy()
        environment.update({"PORT": str(port), "HOST": "127.0.0.1", "BROWSER": "none"})

        if package.is_file():
            try:
                scripts = json.loads(package.read_text()).get("scripts", {})
            except (OSError, json.JSONDecodeError):
                scripts = {}
            if "build" in scripts:
                log.write("Building website...\n")
                log.flush()
                try:
                    build = subprocess.run(
                        [command[0], "run", "build"],
                        cwd=folder,
                        env=environment,
                        stdout=log,
                        stderr=subprocess.STDOUT,
                        timeout=300,
                    )
                except (OSError, subprocess.TimeoutExpired) as exc:
                    log.write(f"Build error: {exc}\n")
                    return fail("Website build failed.", log_path, log)
                if build.returncode != 0:
                    return fail("Website build failed.", log_path, log)

        process = subprocess.Popen(
            command,
            cwd=folder,
            env=environment,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        url = f"http://localhost:{port}"
        RUNNING[key] = {"process": process, "url": url, "log": log, "log_path": log_path}
        FAILURES.pop(key, None)

    deadline = time.time() + 20
    while time.time() < deadline:
        if process.poll() is not None:
            RUNNING.pop(key, None)
            log.flush()
            try:
                recent_output = log_path.read_text(errors="replace")[-12000:].lower()
            except OSError:
                recent_output = ""
            port_conflict = any(marker in recent_output for marker in (
                "eaddrinuse", "address already in use", "port is already in use",
                "port already in use", "port is in use",
            ))
            if port_conflict and port_attempt < 4:
                log.write(f"\nPort {port} is occupied. Retrying automatically on another port...\n")
                log.flush()
                log.close()
                return start_project(folder, port_attempt + 1)
            return fail("The website server did not start.", log_path, log)
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.2):
                break
        except OSError:
            time.sleep(0.2)
    return url, None


def start_project_async(folder: Path):
    key = str(folder)
    if BUILDS.get(key, {}).get("status") == "running":
        return False
    BUILDS[key] = {"status": "running", "message": "Preparing build…", "url": ""}

    def work():
        url, error = start_project(folder)
        BUILDS[key].update({
            "status": "failed" if error else "complete",
            "message": error or "Website is live.",
            "url": url or "",
        })

    threading.Thread(target=work, daemon=True).start()
    return True


def stop_project(folder: Path):
    with LOCK:
        item = RUNNING.pop(str(folder), None)
    if not item:
        return
    process = item["process"]
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            process.kill()
    item["log"].close()


def stop_all_projects():
    folders = list(RUNNING)
    for folder in folders:
        stop_project(Path(folder))
    return len(folders)


def pull_project(folder: Path):
    if not (folder / ".git").exists():
        return False, "This website is not connected to a Git repository."
    try:
        result = subprocess.run(
            ["git", "pull"],
            cwd=folder,
            capture_output=True,
            text=True,
            timeout=120,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, f"Pull failed: {exc}"
    output = (result.stdout + result.stderr).strip()
    if result.returncode == 0:
        if "already up to date" in output.lower():
            return True, "Already up to date."
        return True, "Latest changes pulled successfully."
    final_line = output.splitlines()[-1] if output else "Git pull failed."
    return False, final_line


def git_command(folder: Path, arguments, timeout=120):
    environment = os.environ.copy()
    environment["GIT_TERMINAL_PROMPT"] = "0"
    return subprocess.run(
        ["git", *arguments], cwd=folder, capture_output=True, text=True,
        timeout=timeout, env=environment,
    )


def push_preflight(folder: Path):
    if not (folder / ".git").exists():
        return False, "This website is not connected to Git.", None
    try:
        conflicts = git_command(folder, ["diff", "--name-only", "--diff-filter=U"])
        if conflicts.stdout.strip():
            return False, "Resolve the existing merge conflicts before pushing.", None
        fetched = git_command(folder, ["fetch", "--all", "--prune"])
        if fetched.returncode != 0:
            return False, (fetched.stderr.strip().splitlines() or ["Unable to fetch the remote."])[-1], None
        head = git_command(folder, ["rev-parse", "HEAD"]).stdout.strip()
        upstream_result = git_command(folder, ["rev-parse", "--verify", "@{u}"])
        upstream = upstream_result.stdout.strip() if upstream_result.returncode == 0 else ""
        if upstream:
            safe = git_command(folder, ["merge-base", "--is-ancestor", upstream, "HEAD"])
            if safe.returncode != 0:
                return False, "The remote has newer changes. Pull Latest before committing and pushing.", None
        branch = git_command(folder, ["branch", "--show-current"]).stdout.strip()
        if not branch:
            return False, "This repository is not currently on a branch.", None
        status = git_command(folder, ["status", "--porcelain"])
        changed = len([line for line in status.stdout.splitlines() if line.strip()])
        ahead = 0
        if upstream:
            count = git_command(folder, ["rev-list", "--count", f"{upstream}..HEAD"])
            if count.returncode == 0:
                ahead = int(count.stdout.strip() or "0")
        token = secrets.token_urlsafe(24)
        PREFLIGHTS[token] = {
            "folder": str(folder), "head": head, "upstream": upstream,
            "branch": branch, "not_before": time.time() + 3, "expires": time.time() + 120,
        }
        return True, "Remote check passed.", {"token": token, "changed": changed, "ahead": ahead, "branch": branch}
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, f"Git safety check failed: {exc}", None


def commit_and_push(folder: Path, token: str, message: str):
    check = PREFLIGHTS.pop(token, None)
    if not check or check["folder"] != str(folder) or check["expires"] < time.time():
        return False, "The safety check expired. Please check again."
    if time.time() < check["not_before"]:
        return False, "The three-second confirmation was not completed. Nothing was pushed."
    if not message.strip():
        return False, "Enter a commit message before pushing."
    try:
        head = git_command(folder, ["rev-parse", "HEAD"]).stdout.strip()
        if head != check["head"]:
            return False, "The repository changed after the safety check. Please check again."
        fetched = git_command(folder, ["fetch", "--all", "--prune"])
        if fetched.returncode != 0:
            return False, "The remote could not be rechecked. Nothing was pushed."
        if check["upstream"]:
            upstream_now = git_command(folder, ["rev-parse", "--verify", "@{u}"]).stdout.strip()
            if upstream_now != check["upstream"]:
                return False, "The remote changed during confirmation. Nothing was pushed."
        git_command(folder, ["add", "-A"])
        staged = git_command(folder, ["diff", "--cached", "--quiet"])
        if staged.returncode != 0:
            committed = git_command(folder, ["commit", "-m", message.strip()])
            if committed.returncode != 0:
                detail = (committed.stderr + committed.stdout).strip().splitlines()
                return False, detail[-1] if detail else "The commit failed."
        elif not check["upstream"]:
            return False, "There are no changes to commit."
        if check["upstream"]:
            pushed = git_command(folder, ["push"])
        else:
            pushed = git_command(folder, ["push", "-u", "origin", check["branch"]])
        if pushed.returncode != 0:
            detail = (pushed.stderr + pushed.stdout).strip().splitlines()
            return False, (detail[-1] if detail else "Push failed.") + " The commit remains local."
        return True, "Changes committed and pushed successfully."
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, f"Commit or push failed: {exc}"


def project_logs(folder: Path):
    key = str(folder)
    failure = BUILDS.get(key) or FAILURES.get(key)
    if not failure or not failure.get("log_path"):
        return "Waiting for build output…"
    try:
        content = Path(failure["log_path"]).read_text(errors="replace")
    except OSError as exc:
        return f"Unable to read the log: {exc}"
    return content[-50000:] or "The log is empty."


def build_status(folder: Path):
    build = BUILDS.get(str(folder), {"status": "idle", "message": "No build has run yet.", "url": ""})
    return {"status": build.get("status", "idle"), "message": build.get("message", ""), "url": build.get("url", ""), "log": project_logs(folder)}


