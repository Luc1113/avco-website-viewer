.stat { padding:16px 10px; border-radius:4px; background:var(--paper); border:1px solid var(--line); text-align:center; border-left:2px solid var(--accent); }.stat strong { display:block; font-family:"Poppins",Arial,sans-serif; font-size:26px; font-weight:700; letter-spacing:-.02em; }.stat span { color:var(--muted); font-size:10px; letter-spacing:.12em; text-transform:uppercase; }
button,.button { border:0; border-radius:8px; cursor:pointer; padding:11px 18px; font:600 14px "Poppins",Arial,sans-serif; text-decoration:none; display:inline-flex; align-items:center; justify-content:center; letter-spacing:.01em; transition:.15s ease; }
.toolbar { display:flex; justify-content:space-between; align-items:center; margin:0 2px 14px; gap:12px }.toolbar h3 { margin:0; font-size:12px; font-weight:600; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); }.toolbar-actions{display:flex;gap:8px}.logs-tab{color:var(--ink);background:var(--paper);border:1px solid var(--line)}.logs-tab.has-error{color:#ffd9d9;background:#3a1c1f;border-color:#6b3238}.logs-tab.active{box-shadow:0 0 0 2px #5fd48755}
.filters{display:grid;grid-template-columns:minmax(220px,1fr) 200px;gap:10px;margin:0 2px 20px}.search-wrap{position:relative}.search-wrap:before{content:"⌕";position:absolute;left:15px;top:11px;color:var(--accent);font-size:18px}.search,.sort{width:100%;height:44px;border-radius:8px;border:1px solid var(--line);background:var(--paper);color:var(--ink);font:15px "Lora",Georgia,serif;outline:none;transition:.2s}.search{padding:0 15px 0 42px}.sort{padding:0 13px}.search:focus,.sort:focus{border-color:var(--accent)}.search::placeholder{color:var(--muted)}
.refresh { color:var(--deep); background:var(--accent); white-space:nowrap; }.refresh:hover{filter:brightness(1.08)}.close-all{color:#ffdfe2;background:#3a1c1f;border:1px solid #6b3238}.close-all:hover{background:#4a2226}
.grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(288px,1fr)); gap:16px; }
.card { position:relative; background:var(--paper); border:1px solid var(--line); border-radius:10px; padding:22px; min-height:224px; display:flex; flex-direction:column; transition:.2s ease; overflow:hidden; animation:rise .5s ease both; }
.card:hover { border-color:var(--accent); transform:translateY(-2px); }
.top { display:flex; justify-content:space-between; gap:12px; align-items:start; }
.identity { display:flex;gap:12px;align-items:center;min-width:0 }.project-icon { flex:0 0 40px;width:40px;height:40px;border-radius:8px;display:grid;place-items:center;background:#16321f;border:1px solid var(--line);color:var(--accent);font-weight:700;font-family:"Poppins",Arial,sans-serif;font-size:16px }.identity-text{min-width:0}
h2 { font-size:19px; font-weight:600; line-height:1.2; margin:0; letter-spacing:-.01em; overflow-wrap:anywhere; }
.type { color:var(--muted);font-size:11px;margin-top:4px;font-weight:500 }
.badge { color:var(--muted); background:#16321f; border:1px solid var(--line); border-radius:5px; padding:4px 9px; font-size:11px; font-weight:600; white-space:nowrap; }
.badge.live { color:var(--deep); background:var(--accent); border-color:var(--accent); }
.path { color:var(--muted); font:11px/1.4 ui-monospace,SFMono-Regular,Menlo,monospace; margin:18px 0 22px; padding:9px 11px; border-radius:6px; background:var(--deep); border:1px solid var(--line); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:auto; }
.run { background:var(--mint); color:var(--deep); flex:1; }.open { background:var(--accent); color:var(--deep); flex:1; overflow:hidden;text-overflow:ellipsis;white-space:nowrap }.stop { color:var(--ink); background:#16321f; border:1px solid var(--line); }.pull { color:var(--ink); background:#16321f; border:1px solid var(--line); }.run:hover,.open:hover,.pull:hover,.stop:hover{filter:brightness(1.1)} button:disabled{opacity:.5;cursor:wait}
.push { color:var(--ink);background:#1c3826;border:1px solid var(--line) }.push:hover{background:#22432d}
.empty { border:1px dashed var(--line); background:var(--paper); border-radius:10px; padding:52px 24px; text-align:center; color:var(--muted); }
.toast { position:fixed; right:20px; bottom:20px; background:var(--accent); color:var(--deep); padding:13px 18px; border-radius:8px; font:600 14px "Poppins",Arial,sans-serif; box-shadow:0 18px 50px #0008; opacity:0; transform:translateY(10px); pointer-events:none; transition:.2s; }
.toast.show { opacity:1; transform:none; }
.modal-backdrop{display:none;position:fixed;inset:0;z-index:20;background:#000c;backdrop-filter:blur(8px);padding:24px;align-items:center;justify-content:center}.modal-backdrop.active{display:flex}.modal{width:min(560px,100%);border-radius:14px;border:1px solid var(--line);background:var(--paper);padding:28px;box-shadow:0 35px 100px #000}.modal h2{font-family:"Poppins",Arial,sans-serif;font-size:26px;font-weight:700;margin:0 0 8px}.modal p{color:var(--muted)}.commit-message{width:100%;height:48px;border-radius:8px;border:1px solid var(--line);background:var(--deep);color:var(--ink);padding:0 14px;font:15px "Lora",Georgia,serif;margin:12px 0 18px}.settings-label{display:block;font:600 12px "Poppins",Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:0 0 6px}
.modal-actions{display:flex;justify-content:flex-end;gap:8px}.cancel{background:#16321f;color:var(--ink);border:1px solid var(--line)}.safety-check{background:var(--accent);color:var(--deep)}.confirm-stage{display:none}.confirm-stage.active{display:block}.compose-stage.hidden{display:none}.warning-title{color:#ffb2b8;text-align:center;font-size:23px!important;text-transform:uppercase;letter-spacing:.02em}.push-summary{padding:14px;border-radius:8px;background:var(--deep);border:1px solid var(--line);margin:16px 0;color:var(--ink);font-family:"Lora",Georgia,serif}.hold-push{position:relative;width:100%;height:66px;border-radius:10px;overflow:hidden;background:#7a1f28;color:white;font-size:16px;letter-spacing:.02em;user-select:none;-webkit-user-select:none}.hold-push .hold-progress{position:absolute;inset:0 auto 0 0;width:0;background:#a5202d;pointer-events:none}.hold-push .hold-label{position:relative;z-index:1}.hold-push.holding{transform:scale(.99)}
.logs-panel { display:none; }.logs-panel.active { display:block; }.grid.hidden,.filters.hidden{display:none}
.gh-panel{display:none}.gh-panel.active{display:block}
.gh-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px;flex-wrap:wrap}
.gh-head h2{font-size:20px;font-weight:700;margin:0}
.gh-who{color:var(--muted);font-size:13px;font-family:"Lora",Georgia,serif;font-style:italic}
.gh-tabs{display:flex;gap:8px;margin-bottom:16px}
.gh-tab{background:var(--paper);color:var(--ink);border:1px solid var(--line);padding:12px 22px;font:700 13px "Poppins",Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;border-radius:8px}
.gh-tab.active{background:var(--accent);color:var(--deep);border-color:var(--accent)}
.gh-table{display:flex;flex-direction:column;gap:10px}
.gh-row{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:16px 18px}
.gh-row-top{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}
.gh-row-name{font:600 16px "Poppins",Arial,sans-serif}
.gh-row-meta{color:var(--muted);font-size:12px;margin-top:4px}
.gh-row-actions{display:flex;gap:8px;flex-wrap:wrap}
.gh-badge{background:#16321f;border:1px solid var(--line);color:var(--muted);border-radius:5px;padding:3px 9px;font-size:11px;font-weight:600}
.gh-badge.dirty{color:#ffd9d9;background:#3a1c1f;border-color:#6b3238}
.gh-badge.ahead{color:var(--deep);background:var(--accent);border-color:var(--accent)}
.gh-branches{margin-top:12px;display:none;flex-direction:column;gap:6px;border-top:1px solid var(--line);padding-top:12px}
.gh-branches.open{display:flex}
.gh-branch-row{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:13px}
.gh-branch-row span{color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
.device-code{font:800 40px "Poppins",Arial,sans-serif;letter-spacing:.12em;text-align:center;background:var(--deep);border:1px solid var(--line);border-radius:10px;padding:20px;margin:16px 0;color:var(--lime)}
.org-list{display:flex;flex-direction:column;gap:8px;max-height:320px;overflow:auto;margin:16px 0}
.org-item{background:var(--deep);border:1px solid var(--line);border-radius:8px;padding:12px 16px;text-align:left;color:var(--ink);font:600 15px "Poppins",Arial,sans-serif}
.org-item:hover{border-color:var(--accent)}.console-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:14px}.console-head h2{font-size:20px;font-weight:700}.console-status{color:var(--accent);font-size:13px;font-family:"Lora",Georgia,serif;font-style:italic}.console-actions{display:flex;gap:8px}.log-card{background:var(--paper);border:1px solid #6b3238;border-radius:10px;padding:22px;margin-bottom:14px}.log-card h2{color:#ffd4d7;margin-bottom:6px}.log-error{color:#ff9ca6;font-weight:600;margin-bottom:14px;font-family:"Lora",Georgia,serif}.log-output{margin:0;height:min(55vh,520px);overflow:auto;padding:18px;border-radius:8px;background:var(--deep);border:1px solid var(--line);color:#bfe8c4;font:12px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace;white-space:pre-wrap;word-break:break-word}.logs-empty{color:var(--muted);padding:40px;text-align:center;border:1px dashed var(--line);border-radius:10px;font-style:italic}
@keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.card:nth-child(1){animation-delay:.02s}.card:nth-child(2){animation-delay:.06s}.card:nth-child(3){animation-delay:.1s}.card:nth-child(4){animation-delay:.14s}.card:nth-child(5){animation-delay:.18s}.card:nth-child(6){animation-delay:.22s}
@media(max-width:720px){ main{padding-top:20px}.nav{padding-bottom:24px}header{grid-template-columns:1fr;padding-bottom:26px}.stats{margin-top:10px}.toolbar{gap:12px;align-items:flex-start}.toolbar-actions{flex-wrap:wrap;justify-content:flex-end}.filters{grid-template-columns:1fr}.refresh{padding-inline:14px}.grid{grid-template-columns:1fr} }
</style></head>
<body><main><nav class="nav"><div class="brand"><div class="mark">AVCO</div><span>Website Operations</span></div><div class="nav-status"><i class="pulse"></i>Local workspace connected</div></nav><header><div><div class="eyebrow">Development command center</div><h1>Website Viewer</h1><p class="sub">Build, launch, update, and inspect every AVCO website from one focused workspace.</p></div><div class="stats"><div class="stat"><strong id="total">–</strong><span>Projects</span></div><div class="stat"><strong id="live">–</strong><span>Live</span></div><div class="stat"><strong id="npm">–</strong><span>npm</span></div></div></header><div class="toolbar"><h3>Projects in <span id="rootLabel">__ROOT__</span></h3><div class="toolbar-actions"><button id="githubTab" class="logs-tab" onclick="showGithub()">⇄ GitHub</button><button id="settingsTab" class="logs-tab" onclick="openSettings()" aria-label="Settings">⚙ Settings</button><button id="logsTab" class="logs-tab" onclick="showLogs()">Build console</button><button class="refresh" onclick="load()">Refresh</button></div></div><div id="filters" class="filters"><label class="search-wrap"><input id="search" class="search" type="search" placeholder="Search websites…" oninput="renderProjects()" aria-label="Search websites"></label><select id="sort" class="sort" onchange="renderProjects()" aria-label="Sort websites"><option value="recent">Recently changed</option><option value="alpha">Alphabetical A–Z</option><option value="live">Live websites first</option><option value="type">Website type</option></select></div><section id="grid" class="grid"></section><section id="logsPanel" class="logs-panel"></section><section id="ghPanel" class="gh-panel"><div class="gh-head"><div><h2>GitHub</h2><div id="ghWho" class="gh-who">Not signed in</div></div><div class="toolbar-actions"><button id="ghOrgBtn" class="logs-tab" style="display:none" onclick="openOrgPicker()">Switch organization</button><button id="ghSignBtn" class="refresh" onclick="startSignIn()">Sign in with GitHub</button><button onclick="showProjects()">← Projects</button></div></div><div id="ghTabs" class="gh-tabs" style="display:none"><button id="ghTabLocal" class="gh-tab active" onclick="setGhTab('local')">Local</button><button id="ghTabPushed" class="gh-tab" onclick="setGhTab('pushed')">Pushed</button></div><div id="ghLocalTable" class="gh-table"></div><div id="ghPushedTable" class="gh-table" style="display:none"></div></section></main><div class="toast" id="toast"></div>
<div id="deviceModal" class="modal-backdrop" role="dialog" aria-modal="true"><div class="modal"><h2>Sign in with GitHub</h2><p id="deviceIntro">Opening GitHub in your browser…</p><div id="deviceCode" class="device-code" style="display:none"></div><p id="deviceStatus" style="text-align:center;color:var(--muted)"></p><div class="modal-actions"><button class="cancel" onclick="closeDeviceModal()">Cancel</button></div></div></div>
<div id="orgModal" class="modal-backdrop" role="dialog" aria-modal="true"><div class="modal"><h2>Choose an organization</h2><p>Pick the GitHub organization to browse.</p><div id="orgList" class="org-list"></div><div class="modal-actions"><button class="cancel" onclick="closeOrgPicker()">Cancel</button></div></div></div><div id="pushModal" class="modal-backdrop" role="dialog" aria-modal="true"><div class="modal"><div id="composeStage" class="compose-stage"><h2>Commit & Push</h2><p id="pushProject"></p><input id="commitMessage" class="commit-message" placeholder="Describe your changes…" maxlength="180"><div class="modal-actions"><button class="cancel" onclick="closePushModal()">Cancel</button><button id="checkPush" class="safety-check" onclick="checkPushSafety()">Check remote safety</button></div></div><div id="confirmStage" class="confirm-stage"><h2 class="warning-title">Are you sure you would like to push?</h2><div id="pushSummary" class="push-summary"></div><p style="text-align:center">Hold the red button continuously for three seconds. Releasing early cancels the push.</p><button id="holdPush" class="hold-push"><span class="hold-progress"></span><span class="hold-label">YES — HOLD 3 SECONDS TO PUSH</span></button><div class="modal-actions" style="margin-top:12px"><button class="cancel" onclick="closePushModal()">Cancel</button></div></div></div></div><div id="settingsModal" class="modal-backdrop" role="dialog" aria-modal="true"><div class="modal"><h2>Settings</h2><p>Choose which folder Website Viewer scans, and how often the dashboard refreshes.</p><label class="settings-label" for="rootInput">Website folder</label><input id="rootInput" class="commit-message" placeholder="/Users/you/avco"><label class="settings-label" for="refreshInput">Auto-refresh</label><select id="refreshInput" class="sort" style="width:100%;margin:0 0 16px"><option value="5000">Every 5 seconds</option><option value="10000">Every 10 seconds</option><option value="30000">Every 30 seconds</option><option value="60000">Every minute</option><option value="0">Off</option></select><div class="modal-actions"><button class="cancel" onclick="closeSettings()">Cancel</button><button class="safety-check" onclick="saveSettings()">Save</button></div></div></div>
<script>
const grid=document.querySelector('#grid'), toast=document.querySelector('#toast'), logsPanel=document.querySelector('#logsPanel'), logsTab=document.querySelector('#logsTab');let latestProjects=[];
function safe(s){const e=document.createElement('span');e.textContent=s;return e.innerHTML}
function note(message){toast.textContent=message;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),2600)}
function cardMarkup(p){
 const key=encodeURIComponent(p.key), state=encodeURIComponent(JSON.stringify([p.name,p.kind,p.git,p.npm,p.running,p.url,p.error]));
 return `<article class="card" data-key="${key}" data-state="${state}"><div class="top"><div class="identity"><div class="project-icon">${safe(p.name.charAt(0).toUpperCase())}</div><div class="identity-text"><h2>${safe(p.name)}</h2><div class="type">${safe(p.kind)}${p.git?' · Git connected':''}</div></div></div><span class="badge ${p.running?'live':''}">${p.running?'● Live':(p.error?'! Build failed':'Ready')}</span></div><div class="path" title="${safe(p.path)}">${safe(p.path)}</div><div class="actions">${p.running?`<a class="button open" href="${p.url}" target="_blank">${safe(p.url)} ↗</a><button class="stop" onclick="stopSite('${key}')">Stop</button>`:`<button class="run" onclick="runSite('${key}',this)">${p.npm?'⚒ Build & run':'▶ Run locally'}</button>`}${p.error?`<button class="logs-tab" onclick="showLogs('${key}')">! View logs</button>`:''}<button class="pull" onclick="pullSite('${key}',this)">↓ Pull latest</button>${p.git?`<button class="push" onclick="openPushModal('${key}')">↑ Commit & Push</button>`:''}</div></article>`;
}
async function load(){
 if(!grid.dataset.ready)grid.innerHTML='<div class="empty">Scanning your folders…</div>';
 const projects=await fetch('/api/projects').then(r=>r.json());
 latestProjects=projects;const failureCount=projects.filter(p=>p.error).length;logsTab.textContent=failureCount?`! Build console (${failureCount})`:'› Build console';logsTab.classList.toggle('has-error',failureCount>0);
 document.querySelector('#total').textContent=projects.length;document.querySelector('#live').textContent=projects.filter(p=>p.running).length;document.querySelector('#npm').textContent=projects.filter(p=>p.npm).length;
 renderProjects();
}
function renderProjects(){
 const query=(document.querySelector('#search').value||'').trim().toLowerCase(), mode=document.querySelector('#sort').value;let projects=latestProjects.filter(p=>!query||p.name.toLowerCase().includes(query)||p.path.toLowerCase().includes(query)||p.kind.toLowerCase().includes(query));
 projects.sort((a,b)=>{const liveFirst=b.running-a.running;if(liveFirst)return liveFirst;if(mode==='recent')return (a.npm-b.npm)||(b.modified-a.modified)||a.name.localeCompare(b.name);if(mode==='live')return (a.npm-b.npm)||a.name.localeCompare(b.name);if(mode==='type')return (a.npm-b.npm)||a.kind.localeCompare(b.kind)||a.name.localeCompare(b.name);return (a.npm-b.npm)||a.name.localeCompare(b.name)});
 if(!projects.length){grid.innerHTML=`<div class="empty">${latestProjects.length?'No websites match your search.':'No website projects found yet.<br><small>Website Viewer recognizes common app projects and folders with an index.html file.</small>'}</div>`;grid.dataset.ready='1';return}
 grid.querySelectorAll('.empty').forEach(item=>item.remove());
 const existing=new Map([...grid.querySelectorAll('.card')].map(card=>[card.dataset.key,card]));
 const wanted=new Set();
 for(const project of projects){
   const key=encodeURIComponent(project.key), state=encodeURIComponent(JSON.stringify([project.name,project.kind,project.git,project.npm,project.running,project.url,project.error]));
   wanted.add(key);let card=existing.get(key);
   if(!card||card.dataset.state!==state){const template=document.createElement('template');template.innerHTML=cardMarkup(project).trim();const replacement=template.content.firstElementChild;if(card)card.replaceWith(replacement);card=replacement}
   grid.appendChild(card);
 }
 for(const [key,card] of existing)if(!wanted.has(key))card.remove();
 grid.dataset.ready='1';
}
function showProjects(){logsPanel.classList.remove('active');grid.classList.remove('hidden');document.querySelector('#filters').classList.remove('hidden');logsTab.classList.remove('active')}
