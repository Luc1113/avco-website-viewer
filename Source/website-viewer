<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Website Viewer</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<style>
:root { color-scheme:dark; --ink:#eef5ee; --muted:#93ab97; --panel:#0d1f14; --line:#284a34; --lime:#8fe6a8; --deep:#08120c; --mint:#c7ecc9; --paper:#0f2317; --accent:#5fd487; }
* { box-sizing:border-box }
body { margin:0; background:var(--deep); color:var(--ink); font:16px/1.65 "Lora",Georgia,serif; min-height:100vh; overflow-x:hidden; }
body:before { content:""; position:fixed; inset:0; pointer-events:none; background-image:linear-gradient(#ffffff04 1px,transparent 1px),linear-gradient(90deg,#ffffff04 1px,transparent 1px); background-size:64px 64px; mask-image:linear-gradient(to bottom,#000 0,transparent 70%); }
main { position:relative; width:min(1080px,calc(100% - 40px)); margin:0 auto; padding:40px 0 90px; }
h1,h2,h3,.brand,button,.button,.eyebrow,.type,.badge,.toolbar h3 { font-family:"Poppins",Arial,sans-serif; }
.nav { display:flex; align-items:center; justify-content:space-between; padding:6px 0 44px; animation:rise .6s ease both; }
.brand { display:flex; align-items:center; gap:12px; font-weight:700; letter-spacing:.01em; }
.mark { width:36px; height:36px; display:grid; place-items:center; border-radius:9px; color:var(--deep); background:var(--accent); font-size:11px; font-weight:800; letter-spacing:.03em; }
.nav-status { display:flex; align-items:center; gap:9px; color:var(--muted); font-size:13px; font-family:"Lora",Georgia,serif; font-style:italic; }.pulse { width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px #5fd48722; }
header { display:grid; grid-template-columns:1.5fr .7fr; gap:36px; align-items:end; margin-bottom:34px; padding:0 0 34px; border-bottom:1px solid var(--line); position:relative; animation:rise .7s .05s ease both; }
.eyebrow { color:var(--accent); font-size:11px; font-weight:700; letter-spacing:.18em; text-transform:uppercase; }
h1 { margin:10px 0 0; font-weight:700; font-size:clamp(38px,5.6vw,60px); line-height:1.02; letter-spacing:-.02em; }
.sub { color:var(--muted); margin:18px 0 0; max-width:560px; font-size:17px; }
