class Handler(BaseHTTPRequestHandler):
    def send_content(self, status, content, content_type="application/json"):
        body = content.encode()
        self.send_response(status)
        self.send_header("Content-Type", f"{content_type}; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/api/projects":
            self.send_content(200, json.dumps(discover()))
        elif parsed.path == "/api/logs":
            data = urllib.parse.parse_qs(parsed.query)
            folder = valid_project(data.get("path", [""])[0])
            if not folder:
                self.send_content(400, json.dumps({"error": "Website not available"}))
            else:
                self.send_content(200, json.dumps({"log": project_logs(folder)}))
        elif parsed.path == "/api/build-status":
            data = urllib.parse.parse_qs(parsed.query)
            folder = valid_project(data.get("path", [""])[0])
            if not folder:
                self.send_content(400, json.dumps({"error": "Website not available"}))
            else:
                self.send_content(200, json.dumps(build_status(folder)))
        elif parsed.path == "/api/settings":
            self.send_content(200, json.dumps({"root": str(ROOT), "refresh_ms": REFRESH_MS}))
        elif parsed.path == "/api/github/session":
            self.send_content(200, json.dumps({
                "signed_in": bool(GITHUB_STATE.get("token")),
                "login": GITHUB_STATE.get("login"),
                "org": GITHUB_STATE.get("org"),
            }))
        elif parsed.path == "/api/github/orgs":
            if not GITHUB_STATE.get("token"):
                self.send_content(401, json.dumps({"error": "Not signed in."}))
            else:
                self.send_content(200, json.dumps({"orgs": github_orgs()}))
        elif parsed.path == "/api/github/repos":
            token = GITHUB_STATE.get("token")
            org = GITHUB_STATE.get("org")
            if not token or not org:
                self.send_content(401, json.dumps({"error": "Sign in and choose an organization first."}))
            else:
                ok, message, repos = github_repos(org, token)
                self.send_content(200 if ok else 400, json.dumps({"ok": ok, "message": message, "repos": repos}))
        elif parsed.path == "/api/github/branches":
            data = urllib.parse.parse_qs(parsed.query)
            token = GITHUB_STATE.get("token")
            repo = data.get("repo", [""])[0]
            if not token or not repo or "/" not in repo:
                self.send_content(400, json.dumps({"ok": False, "message": "Missing repository.", "branches": []}))
            else:
                owner, name = repo.split("/", 1)
                ok, message, branches = github_branches(owner, name, token)
                self.send_content(200 if ok else 400, json.dumps({"ok": ok, "message": message, "branches": branches}))
        elif parsed.path == "/api/github/local":
            self.send_content(200, json.dumps(local_git_repos()))
        elif parsed.path == "/":
            page = PAGE.replace("__ROOT__", html.escape(str(ROOT)))
            self.send_content(200, page, "text/html")
        else:
            self.send_content(404, json.dumps({"error": "Not found"}))

    def do_POST(self):
        if self.path == "/api/github/device-code":
            ok, message, data = github_start_device_flow()
            self.send_content(200 if ok else 400, json.dumps({"ok": ok, "message": message, "data": data}))
            return
        if self.path == "/api/github/poll":
            length = int(self.headers.get("Content-Length", "0"))
            data = urllib.parse.parse_qs(self.rfile.read(length).decode())
            device_code = data.get("device_code", [""])[0]
            if not device_code:
                self.send_content(400, json.dumps({"pending": False, "error": "Missing device code."}))
                return
            self.send_content(200, json.dumps(github_poll_device_flow(device_code)))
            return
        if self.path == "/api/github/select-org":
            length = int(self.headers.get("Content-Length", "0"))
            data = urllib.parse.parse_qs(self.rfile.read(length).decode())
            org = data.get("org", [""])[0].strip()
            if not org or org not in github_orgs():
                self.send_content(400, json.dumps({"ok": False, "message": "That organization is not available to you."}))
                return
            GITHUB_STATE["org"] = org
            save_github_state()
            self.send_content(200, json.dumps({"ok": True, "org": org}))
            return
        if self.path == "/api/github/sign-out":
            GITHUB_STATE.update({"token": None, "login": None, "org": None})
            save_github_state()
            self.send_content(200, json.dumps({"ok": True}))
            return
        if self.path == "/api/github/clone":
            length = int(self.headers.get("Content-Length", "0"))
            data = urllib.parse.parse_qs(self.rfile.read(length).decode())
            token = GITHUB_STATE.get("token")
            repo = data.get("repo", [""])[0]
            branch = data.get("branch", [""])[0].strip()
            if not token:
                self.send_content(401, json.dumps({"ok": False, "message": "Sign in to GitHub first."}))
                return
            if not repo or "/" not in repo or not branch:
                self.send_content(400, json.dumps({"ok": False, "message": "Missing repository or branch."}))
                return
            owner, name = repo.split("/", 1)
            ok, message = github_clone_or_checkout(owner, name, branch, token)
            self.send_content(200 if ok else 400, json.dumps({"ok": ok, "message": message}))
            return
        if self.path in ("/api/github/pull", "/api/github/push-preflight", "/api/github/commit-push"):
            length = int(self.headers.get("Content-Length", "0"))
            data = urllib.parse.parse_qs(self.rfile.read(length).decode())
            folder = valid_git_folder(data.get("path", [""])[0])
            if not folder:
                self.send_content(400, json.dumps({"ok": False, "message": "That repository is not available."}))
                return
            if self.path == "/api/github/pull":
                ok, message = pull_project(folder)
                self.send_content(200 if ok else 400, json.dumps({"ok": ok, "message": message}))
            elif self.path == "/api/github/push-preflight":
                ok, message, details = push_preflight(folder)
                self.send_content(200 if ok else 400, json.dumps({"ok": ok, "message": message, "details": details}))
            else:
                ok, message = commit_and_push(folder, data.get("token", [""])[0], data.get("message", [""])[0])
                self.send_content(200 if ok else 400, json.dumps({"ok": ok, "message": message}))
            return
        if self.path == "/api/stop-all":
            count = stop_all_projects()
            self.send_content(200, json.dumps({"ok": True, "count": count}))
            return
        if self.path == "/api/settings":
            length = int(self.headers.get("Content-Length", "0"))
            data = urllib.parse.parse_qs(self.rfile.read(length).decode())
            global ROOT, REFRESH_MS
            root_value = data.get("root", [""])[0].strip()
            refresh_value = data.get("refresh_ms", [""])[0].strip()
            if root_value:
                candidate = Path(root_value).expanduser()
                if not candidate.is_dir():
                    self.send_content(400, json.dumps({"ok": False, "message": "That folder does not exist."}))
                    return
                ROOT = candidate.resolve()
            if refresh_value:
                try:
                    parsed_refresh = int(refresh_value)
                except ValueError:
                    self.send_content(400, json.dumps({"ok": False, "message": "Invalid refresh interval."}))
                    return
                if parsed_refresh != 0 and not (2000 <= parsed_refresh <= 120000):
                    self.send_content(400, json.dumps({"ok": False, "message": "Refresh interval must be 0 or between 2 and 120 seconds."}))
                    return
                REFRESH_MS = parsed_refresh
            save_settings()
            self.send_content(200, json.dumps({"ok": True, "root": str(ROOT), "refresh_ms": REFRESH_MS}))
            return
        length = int(self.headers.get("Content-Length", "0"))
        data = urllib.parse.parse_qs(self.rfile.read(length).decode())
        folder = valid_project(data.get("path", [""])[0])
        if not folder:
            self.send_content(400, json.dumps({"error": "That website is not available."}))
            return
        if self.path == "/api/start":
            started = start_project_async(folder)
            self.send_content(200, json.dumps({"started": started, "error": None}))
        elif self.path == "/api/stop":
            stop_project(folder)
            self.send_content(200, json.dumps({"ok": True}))
        elif self.path == "/api/pull":
            ok, message = pull_project(folder)
            self.send_content(200 if ok else 400, json.dumps({"ok": ok, "message": message}))
        elif self.path == "/api/push-preflight":
            ok, message, details = push_preflight(folder)
            self.send_content(200 if ok else 400, json.dumps({"ok": ok, "message": message, "details": details}))
        elif self.path == "/api/commit-push":
            ok, message = commit_and_push(folder, data.get("token", [""])[0], data.get("message", [""])[0])
            self.send_content(200 if ok else 400, json.dumps({"ok": ok, "message": message}))
        else:
            self.send_content(404, json.dumps({"error": "Not found"}))

    def log_message(self, *_):
        pass


def main():
    parser = argparse.ArgumentParser(description="Browse and run local website projects.")
    parser.add_argument("--check", action="store_true", help="list detected websites and exit")
    parser.add_argument("--no-open", action="store_true", help="do not open the browser automatically")
    parser.add_argument("--port", type=int, default=0, help="use a specific dashboard port")
    args = parser.parse_args()
    load_settings()
    load_github_state()
    if args.check:
        print(json.dumps(discover(), indent=2))
        return

    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    url = f"http://127.0.0.1:{server.server_port}"
    print(f"Website Viewer is open at {url}", flush=True)
    print("Press Control-C when you are finished.", flush=True)
    if not args.no_open:
        threading.Timer(0.35, lambda: webbrowser.open(url)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        for folder in list(RUNNING):
            stop_project(Path(folder))
        server.server_close()
        print("\nWebsite Viewer closed.")


if __name__ == "__main__":
    main()
