<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>AVCO Website Viewer</title>
    <organization>com.avcopremier</organization>
    <domains enable_localSystem="true" enable_currentUserHome="true" enable_anywhere="false"/>
    <options customize="never" require-scripts="false" rootVolumeOnly="false" hostArchitectures="arm64"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <pkg-ref id="com.avcopremier.websiteviewer.pkg"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.avcopremier.websiteviewer.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.avcopremier.websiteviewer.pkg" visible="false">
        <pkg-ref id="com.avcopremier.websiteviewer.pkg"/>
    </choice>
    <pkg-ref id="com.avcopremier.websiteviewer.pkg" version="1" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
